---
// The Tide — Hibiscus Coast fish and chips roundup. The ranked list lives in
// `src/data/fish-and-chips.js`, kept by hand the same way `coffee.js` is.
// First page shipped from the Play D queue in `drafts/directory/PLAYBOOK.md`.
//
// Uses the shared `Directory.astro` layout (head, breadcrumb, subscribe, waves,
// the white-on-sand `.card`) rather than the standalone shape `orewa-best-coffee`
// still carries — that one predates the layout. Same rule as every page here:
// nothing is fetched on load; the list is baked in at build time.
import Directory from '../layouts/Directory.astro';
import { fishAndChips } from '../data/fish-and-chips.js';

const SITE = 'https://thetide.co.nz';
const DIRECTORY = '/hibiscus-coast-business-directory';
const PATH = '/hibiscus-coast-best-fish-and-chips';
const UPDATED = '29 August 2026';

// Title and description are meta, so they hold to BRANDING.md §7's impersonal
// register, not the editor's voice (VOICE.md §10.2). "Hibiscus Coast" is the
// search-facing place name; suburbs earn one mention, not a list.
const title = 'Best fish and chips on the Hibiscus Coast | The Tide';
// Count comes from the data so the copy can't drift when a shop is added or cut.
const description = `Where Coasties actually go for a scoop. ${fishAndChips.length} fish and chip shops from Ōrewa out to Gulf Harbour, ranked and kept current by The Tide.`;

// The lede and every blurb are the editor's own voice (VOICE.md): first person,
// "and"/"&" joins, no em dashes, one plain opinion then move on.
const lede =
  "We've all got a Friday night fish and chip shop, the one that's been doing our scoop for years without us ever really checking if it's the best one going. So I checked. The order below is mine, built from a lot of Friday nights and a fair bit of asking around the Coast. Snapper is the fish to order and kūmara chips are not up for debate. The newer places had to earn their spot.";

// Lets `/…-fish-and-chips#kippers-takeaways` link straight to one shop, for
// sending a single recommendation. Macron-aware, like the category pages.
const slug = (name) =>
  name
    .toLowerCase()
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'The Tide', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Business directory', item: `${SITE}${DIRECTORY}` },
    { '@type': 'ListItem', position: 3, name: 'Best fish and chips on the Hibiscus Coast', item: `${SITE}${PATH}` },
  ],
};

// A ranked ItemList: position 1 is the pick, ascending, and the print order
// matches. Each entry is a real `Restaurant` with a machine-readable
// `PostalAddress` (locality from the data file's `town`) — the local-search
// signal a "best fish and chips <place>" page turns on. No `aggregateRating`
// anywhere: we don't collect ratings, and the order is editorial, not a score.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best fish and chips on the Hibiscus Coast',
  description,
  url: `${SITE}${PATH}`,
  numberOfItems: fishAndChips.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: fishAndChips.map((shop, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Restaurant',
      name: shop.name,
      servesCuisine: 'Fish and chips',
      address: {
        '@type': 'PostalAddress',
        streetAddress: shop.location,
        addressLocality: shop.town,
        addressRegion: 'Auckland',
        addressCountry: 'NZ',
      },
      ...(shop.url ? { url: shop.url } : {}),
      ...(shop.phone ? { telephone: shop.phone } : {}),
    },
  })),
};
---

<Directory
  title={title}
  description={description}
  path={PATH}
  robots="index, follow"
  socialImageAlt="The Tide's ranked guide to fish and chips on the Hibiscus Coast"
  eyebrow="Local roundup"
  heading="Best fish and chips on the Hibiscus Coast"
  lede={lede}
  updated={`Last updated ${UPDATED} · ${fishAndChips.length} shops, my order`}
  breadcrumb={[
    { name: 'The Tide', href: '/' },
    { name: 'Business directory', href: DIRECTORY },
    { name: 'Fish and chips' },
  ]}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <ol class="ranked">
    {fishAndChips.map((shop, index) => (
      <li class="card" id={slug(shop.name)}>
        <p class="rank">#{index + 1}</p>
        <h2 class="card-name">
          {shop.url ? (
            <a href={shop.url} target="_blank" rel="noopener">{shop.name}</a>
          ) : (
            shop.name
          )}
        </h2>
        <p class="shop-where">{shop.location}</p>
        <p class="card-blurb">{shop.blurb}</p>
        {shop.phone && (
          <p class="shop-phone">
            <a href={`tel:${shop.phone.replace(/\s+/g, '')}`}>{shop.phone}</a>
          </p>
        )}
      </li>
    ))}
  </ol>

  <p class="footnote">
    Reckon I've got the order wrong, or missed your local?{' '}
    <a href="mailto:hello@thetide.co.nz">flick me a line</a> and I'll go get a
    scoop and see for myself.
  </p>
  <p class="footnote">
    <a href={DIRECTORY}>Back to the Hibiscus Coast business directory</a>
  </p>
</Directory>

<style>
  /* The list order is the ranking, so it's a real <ol>. Cards reuse the
     layout's white-on-sand `.card`; only the rank pill, the address line and
     the phone line are page-specific. */
  .ranked {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  /* Same pill language as the directory's town jump-nav and Featured chip —
     Sea Glass tint, Steel Blue label, no new tokens. */
  .rank {
    align-self: flex-start;
    padding: 0.15rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #45758c;
    background: rgba(162, 197, 211, 0.18);
    border-radius: 999px;
  }

  .card-name {
    margin-top: 0.6rem;
  }

  .shop-where {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8a8272;
    text-wrap: pretty;
  }

  .shop-phone {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .shop-phone a {
    color: #35657d;
    text-underline-offset: 0.15em;
  }
</style>
