---
// The Tide — newsletter signup landing page.
// The signup form is beehiiv's official embed (loader.js): it subscribes
// visitors straight to the beehiiv publication, with no Supabase involved and
// nothing stored on our side. Everything else on the page stays self-contained
// — system fonts, inlined CSS, inline SVG artwork.
const title = 'The Tide — a newsletter worth waiting for';
const description =
  "The Tide is a weekly email newsletter bringing Coasties the week's local stories, news and events. Sign up with just your email.";

// beehiiv subscribe form (Dashboard → Grow → Subscribe Forms). Swap this id if
// the form is ever recreated; nothing else needs to change.
const BEEHIIV_FORM_ID = 'f3068a09-eb5e-4bb2-b2d9-3b34ca2eaa83';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f0e7d6" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%8A%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <main>
      <p class="eyebrow">The Coast's newsletter.</p>
      <h1>
        <img src="/logo.webp" alt="The Tide" width="783" height="979" />
      </h1>
      <p class="tagline">
        You're in good company! Hundreds of Coasties get the week's local
        stories, news and events delivered every week.
      </p>

      <div class="embed">
        <script
          is:inline
          async
          src="https://subscribe-forms.beehiiv.com/v3/loader.js"
          data-beehiiv-form={BEEHIIV_FORM_ID}></script>
        <noscript>
          <a
            class="embed-fallback"
            href={`https://subscribe-forms.beehiiv.com/${BEEHIIV_FORM_ID}`}
            >Sign up for The Tide</a
          >
        </noscript>
      </div>
      <p class="note">Free forever. Unsubscribe any time.</p>
    </main>

    <svg class="waves" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#a2c5d3"
        opacity="0.45"
        d="M0,96 C240,160 480,32 720,64 C960,96 1200,192 1440,128 L1440,220 L0,220 Z"
      ></path>
      <path
        fill="#a2c5d3"
        d="M0,160 C280,96 520,208 760,176 C1000,144 1240,96 1440,176 L1440,220 L0,220 Z"
      ></path>
    </svg>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  html,
  body {
    height: 100%;
  }

  body {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 50% 0%, #faf5ea 0%, #f0e7d6 60%);
    color: #23313c;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-align: center;
    overflow-x: hidden;
  }

  main {
    width: min(40rem, 100% - 3rem);
    padding-block: 4rem 8rem;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #45758c;
  }

  h1 {
    margin-top: 1.25rem;
  }

  h1 img {
    width: min(16rem, 60vw);
    height: auto;
  }

  .tagline {
    margin: 1.25rem auto 0;
    max-width: 34rem;
    font-size: clamp(1.05rem, 0.5vw + 0.95rem, 1.25rem);
    line-height: 1.6;
    color: #5a6672;
    text-wrap: balance;
  }

  /* Wrapper for beehiiv's embedded form. The iframe is injected by
     loader.js at runtime, so it carries no Astro scope hash — reach it
     with :global(). min-height reserves space to limit layout shift while
     the form loads. */
  .embed {
    margin: 2.5rem auto 0;
    max-width: 28rem;
    min-height: 3.4rem;
  }

  .embed :global(iframe) {
    width: 100% !important;
    max-width: 100% !important;
    border: 0;
    margin: 0 auto;
  }

  .embed-fallback {
    display: inline-block;
    padding: 0.9rem 1.6rem;
    font-weight: 700;
    color: #23313c;
    background: #a2c5d3;
    border-radius: 0.65rem;
    text-decoration: none;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #8a8272;
  }

  .waves {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    height: clamp(90px, 18vh, 220px);
    pointer-events: none;
  }
</style>
