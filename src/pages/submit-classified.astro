---
const title = 'Place a classified — The Tide';
const description =
  'Send us a classified for The Tide: a headline, up to 70 words, and how readers can reach you.';

// The ad manager's /submit, rebuilt in The Tide's own clothes. Field for field,
// rule for rule and message for message it is the same form — the only
// difference is where it posts: this one writes to public."Classified" through
// PostgREST instead of /api/classifieds/submit. Both file an unassigned DRAFT
// tagged source=PUBLIC, and the "Public classified submissions" policy in
// supabase/newsletter-ads/migrations enforces the rules below at the door.

// CLASSIFIED_CATEGORIES and their labels, from lib/enums.ts in the ad manager.
const CATEGORIES = [
  { value: 'FOR_SALE', label: 'For sale' },
  { value: 'WANTED', label: 'Wanted' },
  { value: 'SERVICES', label: 'Services' },
  { value: 'JOBS', label: 'Jobs' },
  { value: 'PROPERTY', label: 'Property' },
  { value: 'COMMUNITY', label: 'Community' },
  { value: 'OTHER', label: 'Other' },
];

// CLASSIFIED_WORD_MAX.
const WORD_MAX = 70;

// FEATURED_CLASSIFIED_FEE, formatted the way formatMoney(fee, true) formats it.
const FEE = '$1.99';

// The Stripe Payment Link the featured fee is paid through — the same link the
// ad manager hands out, so a payment arrives in one place however it was asked
// for. A link rather than a Stripe integration: no API key, no webhook, and
// nothing here ever learns that it was paid, which is why the operator still
// marks the fee off by hand. The amount lives at Stripe's end, so FEE above and
// this link have to be changed together.
const PAY_URL = 'https://buy.stripe.com/6oU14pdDt8nF2uoaX64gg04';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f0e7d6" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%8A%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <main>
      <a class="home" href="/">
        <img src="/logo.webp" alt="The Tide — home" width="783" height="979" />
      </a>
      <p class="eyebrow">Classifieds</p>
      <h1>Place a classified in The Tide</h1>
      <p class="lede">
        Classifieds run in our weekly email to the Hibiscus Coast. Send yours
        below — a headline, up to {WORD_MAX} words, and a phone number or email so
        readers can reach you. We'll be in touch to confirm which issue it runs in.
      </p>

      <form id="classified-form" class="card" novalidate>
        <div class="field" data-field="headline">
          <label for="headline">Headline <span class="required">*</span></label>
          <input
            id="headline"
            name="headline"
            type="text"
            maxlength="80"
            placeholder="Tidy 4.2m alloy runabout, Ōrewa"
            required
          />
          <p class="hint" data-hint>A short line readers see first.</p>
        </div>

        <div class="field" data-field="body">
          <label for="body">Your listing <span class="required">*</span></label>
          <textarea id="body" name="body" rows="8" aria-describedby="body-count" required></textarea>
          <p id="body-count" class="counter empty" aria-live="polite">
            No copy yet — up to {WORD_MAX} words
          </p>
          <p class="hint" data-hint>
            Up to {WORD_MAX} words — what it is, why it's worth a look, and anything
            a reader needs to know.
          </p>
        </div>

        <div class="field" data-field="category">
          <label for="category">Category <span class="required">*</span></label>
          <select id="category" name="category">
            {
              CATEGORIES.map((category) => (
                <option value={category.value} selected={category.value === 'FOR_SALE'}>
                  {category.label}
                </option>
              ))
            }
          </select>
        </div>

        {/*
          The one paid extra on this form. Ticking it opens the picker; nothing
          is charged here — the fee is paid on the way out, through the payment
          link the thank-you panel hands over.
        */}
        <div class="featured">
          <label class="check" for="featured">
            <input id="featured" name="featured" type="checkbox" />
            <span>
              <span class="check-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m12 3 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.2l5.9-.9Z"></path>
                </svg>
                Feature my listing — {FEE}
              </span>
              <span class="check-hint">
                Add a photo and your listing runs with it, at the top of the
                classifieds. You&rsquo;ll pay the fee as soon as you&rsquo;ve
                sent this.
              </span>
            </span>
          </label>

          <div class="photo" id="photo" hidden>
            <img id="preview" alt="The photo you picked" hidden />

            <div class="field" data-field="image">
              <label for="image">Your photo <span class="required">*</span></label>
              <input
                id="image"
                name="image"
                type="file"
                accept="image/png,image/jpeg,image/gif,image/webp"
              />
              <p class="hint" data-hint>
                PNG, JPG, GIF or WEBP, up to 5MB. A landscape photo looks best.
              </p>
            </div>
          </div>
        </div>

        <div class="field" data-field="contactName">
          <label for="contactName">Your name <span class="required">*</span></label>
          <input id="contactName" name="contactName" type="text" maxlength="120" autocomplete="name" required />
        </div>

        <div class="row">
          <div class="field" data-field="contactEmail">
            <label for="contactEmail">Email</label>
            <input
              id="contactEmail"
              name="contactEmail"
              type="email"
              inputmode="email"
              autocomplete="email"
              spellcheck="false"
            />
            <p class="hint" data-hint>Email or phone — whichever you'd like readers to use.</p>
          </div>

          <div class="field" data-field="contactPhone">
            <label for="contactPhone">Phone</label>
            <input id="contactPhone" name="contactPhone" type="tel" autocomplete="tel" />
          </div>
        </div>

        {/*
          Honeypot: hidden from people, filled in by bots. Not display:none —
          some bots skip those — and kept out of the tab order and the
          accessibility tree so nobody real ever meets it.
        */}
        <div class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="message" id="form-message" role="alert" hidden></p>

        <button type="submit">Send my listing</button>
      </form>

      <section id="sent" class="card sent" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <h2>Thanks — your listing is in.</h2>
        <p>
          We read every classified before it runs. If it needs a trim or we have
          a question we'll get in touch using the details you gave us, and we'll
          confirm which issue it appears in.
        </p>
        <p id="sent-featured" hidden>
          You asked to feature it, so your photo comes along with the listing.
          Pay the {FEE} below and it's sorted.
        </p>
        {/*
          Opens in a new tab, so the listing they just sent is still behind them
          if they change their mind. The href is filled in once the row is
          written, so the payment carries the listing's id with it.
        */}
        <a id="pay" class="pay" href={PAY_URL} target="_blank" rel="noopener noreferrer" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
            <path d="M2 10h20"></path>
          </svg>
          Pay here
        </a>
        <button type="button" id="send-another">Send another listing</button>
      </section>

      <p class="footnote">
        Your contact details are printed with your listing so readers can respond —
        please only send details you're happy to have published.
      </p>

      <p class="cross-link"><a href="/submit-event">Running an event? List it here instead.</a></p>

      <p class="privacy-link"><a href="/privacy">How we handle your details</a></p>
    </main>

    <svg class="waves" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#a2c5d3"
        opacity="0.45"
        d="M0,96 C240,160 480,32 720,64 C960,96 1200,192 1440,128 L1440,220 L0,220 Z"
      ></path>
      <path
        fill="#a2c5d3"
        d="M0,160 C280,96 520,208 760,176 C1000,144 1240,96 1440,176 L1440,220 L0,220 Z"
      ></path>
    </svg>

    <script is:inline>
      // Classifieds live in the Newsletter ad management project, not the one
      // the signup forms write to.
      const SUPABASE_URL = 'https://tlderdsxnonhemkdxqns.supabase.co';
      // Publishable key: safe to expose; row-level security only allows inserts.
      const SUPABASE_KEY = 'sb_publishable_lX7NuQ4pMVbVnC0FXFNSzg_1P1jxwl9';

      const WORD_MAX = 70;
      const MIN_SECONDS = 3;

      // FEATURED_CLASSIFIED_FEE. An event's upgrade is priced separately, and
      // the policy pins this number, so a page that drifted from it would
      // simply be refused.
      const FEE = 1.99;
      // Same link as the frontmatter's PAY_URL; the script gets its own copy of
      // every constant on this page.
      const PAY_URL = 'https://buy.stripe.com/6oU14pdDt8nF2uoaX64gg04';
      // The bucket the ad manager keeps creative in; reader photos go in a
      // prefix of their own that the storage policy pins them to.
      const BUCKET = 'creative';
      const PREFIX = 'public-classifieds';
      const MAX_BYTES = 5 * 1024 * 1024;
      // lib/upload.ts's list less SVG, which is a document that can carry
      // script and isn't something to take from a stranger.
      const IMAGE_TYPES = {
        'image/png': 'png',
        'image/jpeg': 'jpg',
        'image/gif': 'gif',
        'image/webp': 'webp',
      };

      const form = document.getElementById('classified-form');
      const sent = document.getElementById('sent');
      const message = document.getElementById('form-message');
      const counter = document.getElementById('body-count');
      const bodyField = document.getElementById('body');
      const headlineField = document.getElementById('headline');
      const honeypot = document.getElementById('website');
      const featured = document.getElementById('featured');
      const imageField = document.getElementById('image');
      const photo = document.getElementById('photo');
      const preview = document.getElementById('preview');
      const sentFeatured = document.getElementById('sent-featured');
      const pay = document.getElementById('pay');

      // Stamped when the form renders; a submission returned faster than a
      // person could type one is refused.
      let startedAt = Date.now();

      // Where the fee gets paid. Tagged with the row once one has been written;
      // the bare link until then, so the panel never offers a link to nowhere.
      let payHref = PAY_URL;

      /**
       * Whitespace-separated tokens that contain at least one letter or digit.
       * A lone dash or bullet isn't a word; "same-day" and "021 555 0142" count
       * the way a person reading the ad would count them.
       */
      function countWords(text) {
        const trimmed = (text ?? '').trim();
        if (trimmed === '') return 0;
        return trimmed.split(/\s+/).filter((token) => /[\p{L}\p{N}]/u.test(token)).length;
      }

      function wordCountState(count) {
        if (count === 0) return 'empty';
        if (count > WORD_MAX) return 'long';
        return 'ok';
      }

      /** `63 words`, `74 words — 4 over the 70-word maximum`. */
      function wordCountMessage(count) {
        const words = `${count} ${count === 1 ? 'word' : 'words'}`;
        switch (wordCountState(count)) {
          case 'empty':
            return `No copy yet — up to ${WORD_MAX} words`;
          case 'long':
            return `${words} — ${count - WORD_MAX} over the ${WORD_MAX}-word maximum`;
          default:
            return words;
        }
      }

      function updateCounter() {
        const count = countWords(bodyField.value);
        counter.textContent = wordCountMessage(count);
        counter.className = `counter ${wordCountState(count)}`;
      }

      const isEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

      /** Turns '' into undefined so optional text fields clear cleanly. */
      function text(name) {
        const value = new FormData(form).get(name);
        const trimmed = value === null ? '' : String(value).trim();
        return trimmed === '' ? undefined : trimmed;
      }

      function showErrors(errors) {
        for (const field of form.querySelectorAll('.field[data-field]')) {
          const name = field.dataset.field;
          const hint = field.querySelector('[data-hint]');
          const previous = field.querySelector('.error');
          if (previous) previous.remove();
          field.querySelector('input, select, textarea')?.removeAttribute('aria-invalid');

          if (errors[name]) {
            // An error replaces the hint, the way the ad manager's Field does.
            if (hint) hint.hidden = true;
            const paragraph = document.createElement('p');
            paragraph.className = 'error';
            paragraph.textContent = errors[name];
            field.append(paragraph);
            field.querySelector('input, select, textarea')?.setAttribute('aria-invalid', 'true');
          } else if (hint) {
            hint.hidden = false;
          }
        }

        const first = form.querySelector('.field .error');
        first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }

      function say(text) {
        message.textContent = text;
        message.hidden = text === null;
      }

      /** The picked photo, or null — the empty file browsers send doesn't count. */
      const picked = () => imageField.files?.[0] ?? null;

      /** Object URLs are only valid until revoked; drop the last one each time. */
      function showPreview() {
        if (preview.src.startsWith('blob:')) URL.revokeObjectURL(preview.src);
        const file = picked();
        if (!file) {
          preview.removeAttribute('src');
          preview.hidden = true;
          return;
        }
        preview.src = URL.createObjectURL(file);
        preview.hidden = false;
      }

      function toggleFeatured() {
        photo.hidden = !featured.checked;
        // Un-ticking drops the photo too, so nothing is uploaded for a listing
        // that isn't running one.
        if (!featured.checked) {
          imageField.value = '';
          showPreview();
        }
      }

      /** publicClassifiedSchema, checked in the browser before anything is posted. */
      function validate() {
        const errors = {};

        const headline = text('headline');
        if (!headline) errors.headline = 'Give your listing a headline';
        else if (headline.length > 80) errors.headline = 'Keep the headline to 80 characters or fewer';

        const body = text('body');
        if (!body) errors.body = 'Write your listing';
        else if (body.length > 2000) errors.body = 'That is longer than a classified can be';
        else {
          const words = countWords(body);
          if (wordCountState(words) !== 'ok') {
            errors.body = `Listings run to ${WORD_MAX} words at most. ${wordCountMessage(words)}.`;
          }
        }

        const contactName = text('contactName');
        if (!contactName) errors.contactName = 'Tell us who to credit this to';
        else if (contactName.length > 120) errors.contactName = 'That name is too long';

        const contactEmail = text('contactEmail');
        const contactPhone = text('contactPhone');
        if (contactEmail && !isEmail(contactEmail)) {
          errors.contactEmail = 'Enter a valid email address';
        }
        if (contactPhone && contactPhone.length > 40) {
          errors.contactPhone = 'That phone number is too long';
        }
        if (!contactEmail && !contactPhone) {
          errors.contactEmail = 'Add an email or a phone number so readers can reply';
        }

        // The upgrade is a photo — without one there is nothing to feature,
        // and the bucket refuses anything the picker shouldn't have let in.
        const image = featured.checked ? picked() : null;
        if (featured.checked) {
          if (!image) errors.image = 'Add a photo, or untick featuring it';
          else if (image.size > MAX_BYTES) errors.image = 'That image must be 5MB or smaller.';
          else if (!IMAGE_TYPES[image.type]) {
            errors.image = 'That image must be a PNG, JPG, GIF or WEBP.';
          }
        }

        return {
          errors,
          image,
          values: {
            headline,
            body,
            category: text('category'),
            contactName,
            contactEmail: contactEmail ?? null,
            contactPhone: contactPhone ?? null,
            // Not negotiable from outside: submissions are unassigned drafts.
            status: 'DRAFT',
            source: 'PUBLIC',
            issueId: null,
            // PostgREST has no application layer to generate a key, so the
            // column carries a database default. We send one anyway: knowing
            // the id before the insert is what lets the payment link name the
            // listing it is paying for, and the row is never read back — the
            // policy is insert-only, so `return=minimal` is all we can ask for.
            id: crypto.randomUUID(),
            // Asking to be featured is not paying for it: the fee is what we
            // charge today, and the fee is collected on the way out rather than
            // invoiced. imageUrl is filled in once the photo is up.
            featured: featured.checked,
            imageUrl: null,
            featuredFee: featured.checked ? FEE : 0,
            featuredPaid: 'UNPAID',
          },
        };
      }

      /**
       * Puts the photo in the bucket and returns its public URL.
       *
       * A generated name keeps the submitter's filename out of the URL and is
       * the shape the storage policy insists on. Nothing here can overwrite an
       * existing object: there is no update policy, and the name is new every
       * time.
       */
      async function upload(image) {
        const name = `${PREFIX}/${crypto.randomUUID()}.${IMAGE_TYPES[image.type]}`;

        // The key travels on `apikey` and nowhere else. A publishable key is
        // not a JWT, and the gateway refuses one sent as `Authorization:
        // Bearer` — it synthesises that header itself from this one, the same
        // way it does for the insert below.
        const response = await fetch(`${SUPABASE_URL}/storage/v1/object/${BUCKET}/${name}`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_KEY,
            'Content-Type': image.type,
          },
          body: image,
        });

        if (!response.ok) return null;
        return `${SUPABASE_URL}/storage/v1/object/public/${BUCKET}/${name}`;
      }

      function finish() {
        form.hidden = true;
        sent.hidden = false;
        sentFeatured.hidden = !featured.checked;
        pay.href = payHref;
        pay.hidden = !featured.checked;
        say(null);
        sent.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }

      bodyField.addEventListener('input', updateCounter);
      featured.addEventListener('change', toggleFeatured);
      imageField.addEventListener('change', showPreview);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        // Honeypot: hidden from people, irresistible to bots. Answer the way a
        // success does, so a script learns nothing from being refused.
        if (honeypot.value.trim() !== '') return finish();

        if ((Date.now() - startedAt) / 1000 < MIN_SECONDS) {
          return say('That was quick — give it another go.');
        }

        const { errors, values, image } = validate();
        showErrors(errors);
        if (Object.keys(errors).length > 0) return say('Check the highlighted fields.');
        say(null);

        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        button.textContent = image ? 'Uploading photo…' : 'Sending…';

        try {
          // The photo goes up first: a listing that claims to be featured and
          // has no image is one the policy would refuse anyway. A stray object
          // is the worst a failure after this can leave behind — nobody sees a
          // photo that no listing points at.
          if (image) {
            values.imageUrl = await upload(image);
            if (!values.imageUrl) {
              return say('Could not upload that photo. Please try again.');
            }
            button.textContent = 'Sending…';
          }

          const response = await fetch(`${SUPABASE_URL}/rest/v1/Classified`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_KEY,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(values),
          });

          if (response.ok) {
            // Stripe records this against the payment, so one in the dashboard
            // can be matched back to the listing it paid for.
            payHref = `${PAY_URL}?client_reference_id=${values.id}`;
            return finish();
          }
          say('Something went wrong saving that. Please try again.');
        } catch {
          say('Could not reach us just now. Please check your connection and retry.');
        } finally {
          button.disabled = false;
          button.textContent = 'Send my listing';
        }
      });

      document.getElementById('send-another').addEventListener('click', () => {
        form.reset();
        showErrors({});
        updateCounter();
        // form.reset() clears the checkbox and the file input, but the picker
        // and the preview are ours to put back.
        toggleFeatured();
        showPreview();
        sent.hidden = true;
        form.hidden = false;
        pay.hidden = true;
        payHref = PAY_URL;
        startedAt = Date.now();
        headlineField.focus();
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  body {
    min-height: 100%;
    background:
      radial-gradient(120% 60% at 50% 0%, #faf5ea 0%, #f0e7d6 60%) no-repeat,
      #f0e7d6;
    color: #23313c;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  main {
    width: min(42rem, 100% - 2.5rem);
    margin-inline: auto;
    padding-block: 2.5rem 9rem;
    text-align: center;
  }

  .home img {
    width: min(7rem, 26vw);
    height: auto;
  }

  .eyebrow {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #45758c;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(1.7rem, 1.5vw + 1.2rem, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .lede {
    margin: 1rem auto 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  .card {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.5rem 1.35rem;
    text-align: left;
    background: #fffdf8;
    border: 1px solid rgba(35, 65, 90, 0.12);
    border-radius: 1rem;
  }

  .card[hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    /* Without this a grid column refuses to shrink past an input's intrinsic
       minimum and the page scrolls sideways on a phone. */
    min-width: 0;
  }

  .row {
    display: grid;
    gap: 1rem;
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .required {
    color: #b3372c;
  }

  .hint,
  .error,
  .counter {
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .hint {
    color: #8a8272;
  }

  .hint[hidden] {
    display: none;
  }

  .error {
    font-weight: 600;
    color: #b3372c;
  }

  .counter {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .counter.empty {
    color: #8a8272;
  }

  .counter.ok {
    color: #1e7a4d;
  }

  .counter.long {
    color: #9a6210;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    font: inherit;
