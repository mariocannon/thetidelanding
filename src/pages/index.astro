---
import { issues } from '../data/issues.js';

// The Tide — newsletter signup landing page.
// Self-contained on purpose: no web fonts, no external CSS/JS, no images
// beyond the logo, so the page ships as a single small HTML document.

// Origin comes from `site` in astro.config.mjs rather than being typed here,
// so the domain is written down once for the canonical tag and the sitemap.
const SITE = Astro.site.href.replace(/\/$/, '');
const PATH = '/';
const SOCIAL_IMAGE = `${SITE}/social/home-social.png`;

// The suburbs The Tide actually covers. Listed once and reused by the copy,
// the meta description and the structured data, so a change to the patch we
// serve can't leave one of the three saying something else.
// Macronised, matching the reader-facing survey and the `survey_responses`
// CHECK constraint. Slugs and file names stay ASCII — /orewa-best-coffee.
const SUBURBS = ['Ōrewa', 'Whangaparāoa', 'Silverdale', 'Red Beach'];

// "The Coast" is the insider term and holds the identity lines (the eyebrow);
// "Hibiscus Coast" is the name people actually search, so it goes here and in
// the coverage line. Kept under 60 characters so the phrase that carries the
// voice isn't the half Google truncates — this string is the og:title too.
const title = 'The Tide — the Hibiscus Coast newsletter worth waiting for';
const description =
  "A free weekly email for Coasties — the week's local stories, news and events from Ōrewa, Whangaparāoa, Silverdale and Red Beach. Sign up with just your email.";

// Structured data: who we are and where we cover. The home page is the one
// page a search engine should be able to read the whole publication off, so
// it carries the organisation and the site-level entry, and leaves the
// page-specific lists to the pages that have them (see orewa-best-coffee).
const organisationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': `${SITE}/#organisation`,
  name: 'The Tide',
  url: `${SITE}/`,
  logo: `${SITE}/logo.webp`,
  description,
  email: 'hello@thetide.co.nz',
  areaServed: SUBURBS.map((suburb) => ({
    '@type': 'Place',
    name: `${suburb}, Auckland, New Zealand`,
  })),
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  name: 'The Tide',
  url: `${SITE}/`,
  description,
  inLanguage: 'en-NZ',
  publisher: { '@id': `${SITE}/#organisation` },
};
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${SITE}${PATH}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Tide" />
    <meta property="og:url" content={`${SITE}${PATH}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={SOCIAL_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Tide — the Hibiscus Coast newsletter" />
    <meta property="og:locale" content="en_NZ" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SOCIAL_IMAGE} />

    <meta name="theme-color" content="#f0e7d6" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%8A%3C/text%3E%3C/svg%3E"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organisationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </head>
  <body>
    <main>
      <p class="eyebrow">The Coast's newsletter.</p>
      <h1>
        <img
          src="/logo.webp"
          alt="The Tide — the Hibiscus Coast newsletter"
          width="783"
          height="979"
        />
      </h1>
      <p class="tagline">
        You're in good company! Hundreds of Coasties get the week's local
        stories, news and events delivered every week.
      </p>

      <form id="signup" method="post" action="#" novalidate>
        <label class="visually-hidden" for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          spellcheck="false"
          placeholder="you@example.com"
          required
        />
        <button type="submit">Sign up</button>
      </form>
      <p class="note" id="form-note" role="status" aria-live="polite">
        Free forever. Unsubscribe any time.
      </p>

      {/* Sits below the form on purpose: it's the only block on the page that
          names the patch we cover, so it has to be indexable text rather than
          alt text — but it must not push the signup down the page to get
          there. Written as what arrives in a reader's inbox, not as things to
          go and submit; turning it toward submission would make it a third
          call to action. */}
      <section class="coverage">
        <h2>What lands in your inbox</h2>
        <p>
          One email a week: what's on around the Hibiscus Coast — Ōrewa,
          Whangaparāoa, Silverdale and Red Beach — the local news worth
          knowing, and the events and classifieds your neighbours have put up.
        </p>
      </section>

      <p class="cta-buttons">
        <a class="btn-outline" href="/submit-event">List your event</a>
        <a class="btn-outline" href="/submit-classified">Place a classified</a>
        <a class="btn-outline" href="/hibiscus-coast-jobs">View jobs</a>
        <a class="btn-outline" href="/hibiscus-coast-jobs/post">Post a job</a>
      </p>

      {
        issues.length > 0 && (
          <p class="archive-link">
            <a href="/issues">Read a past issue first</a>
          </p>
        )
      }

      <p class="privacy-link"><a href="/privacy">How we handle your details</a></p>
      <p class="event-link">
        <a href="/hibiscus-coast-business-directory">Hibiscus Coast business directory</a>
        <span aria-hidden="true">·</span>
        <a href="/orewa-best-coffee">Best coffee in Orewa</a>
      </p>
    </main>

    <svg class="waves" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#a2c5d3"
        opacity="0.45"
        d="M0,96 C240,160 480,32 720,64 C960,96 1200,192 1440,128 L1440,220 L0,220 Z"
      ></path>
      <path
        fill="#a2c5d3"
        d="M0,160 C280,96 520,208 760,176 C1000,144 1240,96 1440,176 L1440,220 L0,220 Z"
      ></path>
    </svg>

    <script is:inline>
      const form = document.getElementById('signup');
      const email = document.getElementById('email');
      const note = document.getElementById('form-note');

      // Signups insert into the Supabase `subscribers` table — the same path
      // the other pages use. Publishable key: safe to expose; row-level
      // security only allows inserts.
      const SUPABASE_URL = 'https://jykpoupjvcmvoihujfkc.supabase.co';
      const SUPABASE_KEY = 'sb_publishable_aMYowr2D3KMWyiw7IpMeXw_GzXRrIxM';

      // New subscribers go straight on to the reader survey. Same-origin and
      // slash-free on purpose: `trailingSlash: 'never'` means /reader-survey/
      // isn't a real path, and a relative link keeps preview builds on the
      // preview domain.
      const SURVEY_URL = '/reader-survey';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!email.checkValidity()) {
          note.textContent = 'Please enter a valid email address.';
          note.className = 'note error';
          email.focus();
          return;
        }

        const button = form.querySelector('button');
        button.disabled = true;
        button.textContent = 'Signing up…';

        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/subscribers`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_KEY,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify({ email: email.value.trim().toLowerCase() }),
          });

          // 409 = duplicate email: already subscribed, treat as success.
          if (response.ok || response.status === 409) {
            form.hidden = true;
            note.textContent = "You're in! Taking you to a few quick questions…";
            note.className = 'note success';
            window.location.href = SURVEY_URL;
            return;
          }
          throw new Error(`Signup failed with status ${response.status}`);
        } catch {
          note.textContent = "Something went wrong — please try again in a moment.";
          note.className = 'note error';
          button.disabled = false;
          button.textContent = 'Sign up';
        }
      });

      email.addEventListener('input', () => {
        if (note.classList.contains('error')) {
          note.textContent = 'Free forever. Unsubscribe any time.';
          note.className = 'note';
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    /* Declared once and used by both the waves and the space reserved above
       them, so the reserve can't drift out of step with what it's clearing. */
    --wave-height: clamp(90px, 18vh, 220px);
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    height: 100%;
  }

  body {
    /* min-height rather than height, and relative, so the waves below can
       anchor to the foot of the *document* instead of the viewport. Both are
       load-bearing: `position: absolute` with no positioned ancestor resolves
       against the initial containing block, which puts the waves back at the
       100vh mark — the bug this replaced. */
    min-height: 100%;
    position: relative;
    display: grid;
    place-items: center;
    /* no-repeat, with Sand underneath. The background area is the root box,
       which `html { height: 100% }` pins to the viewport — so on any page long
       enough to scroll the gradient tiled, restarting at Foam and drawing a
       hard line across the page. The wash ends at Sand, so painting Sand
       behind it continues it seamlessly however far the page runs. */
    background-color: #f0e7d6;
    background-image:
      radial-gradient(120% 90% at 50% 0%, #faf5ea 0%, #f0e7d6 60%);
    background-repeat: no-repeat;
    color: #23313c;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-align: center;
    overflow-x: hidden;
  }

  main {
    width: min(40rem, 100% - 3rem);
    /* Clears the waves by a fixed margin at every height, because it's the
       wave height plus breathing room rather than a second clamp of its own.
       The guide's clamp(7rem, 20vh, 11rem) only tracks the waves while
       neither clamp is biting: past roughly 978px tall the reserve stops at
       11rem while the waves keep growing to 220px, and copy lands on them. */
    padding-block: 4rem calc(var(--wave-height) + 2rem);
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #45758c;
  }

  h1 {
    margin-top: 1.25rem;
  }

  h1 img {
    width: min(16rem, 60vw);
    height: auto;
  }

  .tagline {
    margin: 1.25rem auto 0;
    max-width: 34rem;
    font-size: clamp(1.05rem, 0.5vw + 0.95rem, 1.25rem);
    line-height: 1.6;
    color: #5a6672;
    text-wrap: balance;
  }

  form[hidden] {
    display: none;
  }

  form {
    display: flex;
    gap: 0.6rem;
    margin: 2.5rem auto 0;
    max-width: 28rem;
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 0.9rem 1.1rem;
    font: inherit;
    color: inherit;
    background: #fffdf8;
    border: 1px solid rgba(35, 65, 90, 0.25);
    border-radius: 0.65rem;
    transition: border-color 0.15s;
  }

  input::placeholder {
    color: #9aa4ac;
  }

  input:focus-visible {
    outline: none;
    border-color: #45758c;
    box-shadow: 0 0 0 3px rgba(162, 197, 211, 0.55);
  }

  button {
    padding: 0.9rem 1.6rem;
    font: inherit;
    font-weight: 700;
    color: #23313c;
    background: #a2c5d3;
    border: 0;
    border-radius: 0.65rem;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  button:hover,
  button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(69, 117, 140, 0.35);
  }

  button:active {
    transform: translateY(0);
  }

  button:disabled {
    cursor: default;
    transform: none;
    box-shadow: none;
    opacity: 0.7;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #8a8272;
  }

  .note.error {
    color: #b3372c;
  }

  .note.success {
    font-size: 1.05rem;
    color: #1e7a4d;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Anchored to the foot of the page, not the viewport. `fixed` is only
     correct while a page fits on one screen — the moment this one scrolls,
     fixed waves float over whatever copy is passing under them, which the
     brand guide forbids outright. This one has scrolled at every viewport
     under ~1165px tall, so it never held. */
  .waves {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: var(--wave-height);
    pointer-events: none;
  }

  @media (max-width: 30rem) {
    form {
      flex-direction: column;
    }

    button {
      width: 100%;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn-outline {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }

  /* Supporting copy, so it reads a step quieter than the tagline above the
     form rather than competing with it. Heading weight and tracking are the
     H2 treatment from the brand guide. */
  .coverage {
    margin: 2.5rem auto 0;
    max-width: 34rem;
  }

  .coverage h2 {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: #23313c;
  }

  .coverage p {
    margin-top: 0.6rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  /* Sits below the CTA buttons, and reads a size up from the fine print
     under it: a reason to trust the signup rather than a footer link.
     Rendered only when there are issues to read — see src/data/issues.js. */
  .archive-link {
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }

  .archive-link a {
    font-weight: 600;
    color: #45758c;
    text-underline-offset: 0.15em;
  }

  .privacy-link {
    margin-top: 1.75rem;
    font-size: 0.8rem;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .btn-outline {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #45758c;
    background: transparent;
    border: 1px solid rgba(69, 117, 140, 0.4);
    border-radius: 0.65rem;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, transform 0.12s;
  }

  .btn-outline:hover,
  .btn-outline:focus-visible {
    background: #45758c;
    color: #fffdf8;
    transform: translateY(-1px);
  }

  .btn-outline:active {
    transform: translateY(0);
  }

  /* Sits under the privacy link and matches it — same size, colour and
     underline as its sibling above. */
  .event-link {
    margin-top: 1rem;
    font-size: 0.8rem;
  }

  .event-link span[aria-hidden] {
    margin: 0 0.4em;
    color: #8a8272;
  }

  .privacy-link a,
  .event-link a {
    color: #8a8272;
    text-underline-offset: 0.15em;
  }

  .privacy-link a:hover,
  .privacy-link a:focus-visible,
  .event-link a:hover,
  .event-link a:focus-visible {
    color: #45758c;
  }
</style>
