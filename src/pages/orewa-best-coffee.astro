---
// The Tide — Orewa coffee roundup. List lives in `src/data/coffee.js`, kept by
// hand the same way `issues.js` is. Same rule as every other page here:
// nothing is fetched from anywhere else on load.
import { coffee } from '../data/coffee.js';

const SITE = 'https://thetide.co.nz';
const PATH = '/orewa-best-coffee';
const UPDATED = '24 August 2026';

const title = 'Best coffee in Orewa, NZ | The Tide';
// Count comes from the data, not typed by hand, so the copy can't drift out
// of sync the next time an entry is added or removed.
const description = `Where Coasties actually go for coffee in Orewa — ${coffee.length} local cafés worth the trip, hand-picked and hand-kept by The Tide.`;

// Structured data so a search engine can show this as a proper local list
// rather than a wall of text. `address` is kept as a plain string — we know
// each spot's landmark, not always its exact street number, and schema.org
// accepts Text for `address` as well as a full PostalAddress. Every entry's
// `location` already ends in "Orewa" (see coffee.js), so only the wider
// region needs appending here.
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'The Tide', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Best coffee in Orewa', item: `${SITE}${PATH}` },
  ],
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best coffee in Orewa',
  description,
  itemListElement: coffee.map((spot, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CafeOrCoffeeShop',
      name: spot.name,
      address: `${spot.location}, Auckland, New Zealand`,
      ...(spot.url ? { url: spot.url } : {}),
    },
  })),
};

// Same slugify a reader would expect: lets `/orewa-best-coffee#drifter` link
// straight to one spot, for sharing a single recommendation.
const slug = (name) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${SITE}${PATH}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Tide" />
    <meta property="og:url" content={`${SITE}${PATH}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/social/orewa-best-coffee-social.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Best coffee in Orewa — The Tide" />
    <meta property="og:locale" content="en_NZ" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/social/orewa-best-coffee-social.png`} />

    <meta name="theme-color" content="#f0e7d6" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%8A%3C/text%3E%3C/svg%3E"
    />

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </head>
  <body>
    <main>
      <a class="home" href="/">
        <img src="/logo.webp" alt="The Tide — home" width="783" height="979" />
      </a>

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">The Tide</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Best coffee in Orewa</span>
      </nav>

      <p class="eyebrow">Local roundup</p>
      <h1>Best coffee in Orewa</h1>
      <p class="lede">
        Where Coasties actually go for a decent flat white — {coffee.length}{' '}
        local spots worth the trip, no two of them alike.
      </p>
      <p class="updated">
        Last updated {UPDATED} · a working list, we'll add to it as we find more
      </p>

      <ul class="spots">
        {coffee.map((spot) => (
          <li class="spot" id={slug(spot.name)}>
            <h2 class="spot-name">
              {spot.url ? (
                <a href={spot.url} target="_blank" rel="noopener">
                  {spot.name}
                </a>
              ) : (
                spot.name
              )}
            </h2>
            <address class="spot-location">{spot.location}</address>
            <p class="spot-blurb">{spot.blurb}</p>
          </li>
        ))}
      </ul>

      <p class="feedback-note">
        Know a spot that should be on this list? Email{' '}
        <a href="mailto:hello@thetide.co.nz">hello@thetide.co.nz</a> and we'll
        go try it.
      </p>

      <section id="subscribe">
        <p class="subscribe-pitch">
          Want the week's local stories, news and events? Join The Tide.
        </p>
        <form id="subscribe-form" method="post" action="#" novalidate>
          <label class="visually-hidden" for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            spellcheck="false"
            placeholder="you@example.com"
            required
          />
          <button type="submit">Subscribe</button>
        </form>
        <p class="note" id="subscribe-note" role="status" aria-live="polite">
          Free forever. Unsubscribe any time.
        </p>
      </section>

      <p class="privacy-link"><a href="/privacy">How we handle your details</a></p>
    </main>

    <svg class="waves" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#a2c5d3"
        opacity="0.45"
        d="M0,96 C240,160 480,32 720,64 C960,96 1200,192 1440,128 L1440,220 L0,220 Z"
      ></path>
      <path
        fill="#a2c5d3"
        d="M0,160 C280,96 520,208 760,176 C1000,144 1240,96 1440,176 L1440,220 L0,220 Z"
      ></path>
    </svg>

    <script is:inline>
      // Same insert as the home page's form: the `subscribers` table, with the
      // publishable key. Row-level security only allows inserts.
      const SUPABASE_URL = 'https://jykpoupjvcmvoihujfkc.supabase.co';
      const SUPABASE_KEY = 'sb_publishable_aMYowr2D3KMWyiw7IpMeXw_GzXRrIxM';

      const subscribeForm = document.getElementById('subscribe-form');
      const subscribeEmail = subscribeForm.querySelector('#email');
      const subscribeNote = document.getElementById('subscribe-note');

      subscribeForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!subscribeEmail.checkValidity()) {
          subscribeNote.textContent = 'Please enter a valid email address.';
          subscribeNote.className = 'note error';
          subscribeEmail.focus();
          return;
        }

        const subscribeButton = subscribeForm.querySelector('button');
        subscribeButton.disabled = true;
        subscribeButton.textContent = 'Subscribing…';

        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/subscribers`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_KEY,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify({ email: subscribeEmail.value.trim().toLowerCase() }),
          });

          // 409 = duplicate email: already subscribed, treat as success.
          if (response.ok || response.status === 409) {
            subscribeForm.hidden = true;
            subscribeNote.textContent =
              "You're in! Check your inbox for your welcome email, then keep an eye out for your weekly issue of The Tide.";
            subscribeNote.className = 'note success';
            return;
          }
          throw new Error(`Signup failed with status ${response.status}`);
        } catch {
          subscribeNote.textContent = 'Something went wrong — please try again in a moment.';
          subscribeNote.className = 'note error';
          subscribeButton.disabled = false;
          subscribeButton.textContent = 'Subscribe';
        }
      });

      subscribeEmail.addEventListener('input', () => {
        if (subscribeNote.classList.contains('error')) {
          subscribeNote.textContent = 'Free forever. Unsubscribe any time.';
          subscribeNote.className = 'note';
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  body {
    min-height: 100%;
    background:
      radial-gradient(120% 60% at 50% 0%, #faf5ea 0%, #f0e7d6 60%) no-repeat,
      #f0e7d6;
    color: #23313c;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  main {
    width: min(42rem, 100% - 2.5rem);
    margin-inline: auto;
    padding-block: 2.5rem 9rem;
    text-align: center;
  }

  .home img {
    width: min(7rem, 26vw);
    height: auto;
  }

  .breadcrumb {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: #8a8272;
  }

  .breadcrumb a {
    color: #8a8272;
    text-underline-offset: 0.15em;
  }

  .breadcrumb a:hover,
  .breadcrumb a:focus-visible {
    color: #45758c;
  }

  .breadcrumb span[aria-hidden] {
    margin: 0 0.35em;
  }

  .eyebrow {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #45758c;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(1.7rem, 1.5vw + 1.2rem, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .lede {
    margin: 1rem auto 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  .updated {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: #8a8272;
  }

  .spots {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  /* One card per spot, in the same white-on-sand card the issues list uses. */
  .spot {
    padding: 1.35rem 1.35rem 1.5rem;
    text-align: left;
    background: #fffdf8;
    border: 1px solid rgba(35, 65, 90, 0.12);
    border-radius: 1rem;
    scroll-margin-top: 1.5rem;
  }

  .spot:hover,
  .spot:focus-within {
    border-color: rgba(69, 117, 140, 0.4);
  }

  .spot-name {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .spot-name a {
    color: #23313c;
    text-decoration-color: rgba(69, 117, 140, 0.45);
    text-underline-offset: 0.15em;
  }

  .spot-name a:hover,
  .spot-name a:focus-visible {
    color: #45758c;
  }

  .spot-location {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    font-style: normal;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8a8272;
  }

  .spot-blurb {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  .feedback-note {
    margin: 1.5rem auto 0;
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  .feedback-note a {
    color: #35657d;
    text-underline-offset: 0.15em;
  }

  #subscribe {
    margin-top: 2.5rem;
  }

  .subscribe-pitch {
    margin-inline: auto;
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  form[hidden] {
    display: none;
  }

  form {
    display: flex;
    gap: 0.6rem;
    margin: 1.25rem auto 0;
    max-width: 28rem;
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 0.9rem 1.1rem;
    font: inherit;
    color: inherit;
    background: #fffdf8;
    border: 1px solid rgba(35, 65, 90, 0.25);
    border-radius: 0.65rem;
    transition: border-color 0.15s;
  }

  input::placeholder {
    color: #9aa4ac;
  }

  input:focus-visible {
    outline: none;
    border-color: #45758c;
    box-shadow: 0 0 0 3px rgba(162, 197, 211, 0.55);
  }

  button {
    padding: 0.9rem 1.6rem;
    font: inherit;
    font-weight: 700;
    color: #23313c;
    background: #a2c5d3;
    border: 0;
    border-radius: 0.65rem;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  button:hover,
  button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(69, 117, 140, 0.35);
  }

  button:active {
    transform: translateY(0);
  }

  button:disabled {
    cursor: default;
    transform: none;
    box-shadow: none;
    opacity: 0.7;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #8a8272;
  }

  .note.error {
    color: #b3372c;
  }

  .note.success {
    margin-inline: auto;
    max-width: 30rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: #1e7a4d;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .privacy-link {
    margin-top: 1.75rem;
    font-size: 0.8rem;
  }

  .privacy-link a {
    color: #8a8272;
    text-underline-offset: 0.15em;
  }

  .privacy-link a:hover,
  .privacy-link a:focus-visible {
    color: #45758c;
  }

  .waves {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    height: clamp(90px, 18vh, 220px);
    pointer-events: none;
  }

  @media (max-width: 30rem) {
    form {
      flex-direction: column;
    }

    button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
