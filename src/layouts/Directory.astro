---
// Shared chrome for the business directory — the hub and every category page.
//
// The first layout in this repo, and it exists for one reason: the directory is
// the first thing here that is more than one page of the same shape, and the
// subscribe form is 60 lines of script nobody should be maintaining N copies of.
// Astro still inlines the CSS, so the "one self-contained document, no external
// requests on load" rule in astro.config.mjs holds exactly as before.
//
// Everything a page differs on comes in as a prop. Page-specific markup goes in
// the default slot and is styled by the page's own scoped <style> block.
const {
  title,
  description,
  path,
  robots = 'index, follow',
  // One card for the whole section, rendered from the hub itself by
  // design/social/render-directory.mjs. A per-category card would mean
  // regenerating a PNG every time a listing lands, and a link preview for
  // /…/plumbers reads perfectly well off the directory's own identity.
  socialImage = '/social/directory-social.png',
  socialImageAlt = 'The Tide — Hibiscus Coast business directory',
  eyebrow,
  heading,
  lede,
  updated,
  // [{ name, href }] — the last entry is the current page and takes no href.
  breadcrumb = [],
  jsonLd = [],
  // The roundup pages are a single column at 42rem; the hub carries a grid and
  // wants more room. Passed down as a custom property so a page can widen the
  // layout without having to reach into its scoped styles.
  width = '42rem',
} = Astro.props;

const SITE = 'https://thetide.co.nz';
const canonical = `${SITE}${path}`;
const socialImageUrl = `${SITE}${socialImage}`;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Tide" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content="en_NZ" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <meta name="theme-color" content="#f0e7d6" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%8A%3C/text%3E%3C/svg%3E"
    />

    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body style={`--main-width: ${width}`}>
    <main>
      <a class="home" href="/">
        <img src="/logo.webp" alt="The Tide — home" width="783" height="979" />
      </a>

      <nav class="breadcrumb" aria-label="Breadcrumb">
        {breadcrumb.map((crumb, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {crumb.href ? (
              <a href={crumb.href}>{crumb.name}</a>
            ) : (
              <span aria-current="page">{crumb.name}</span>
            )}
          </>
        ))}
      </nav>

      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lede">{lede}</p>
      <p class="updated">{updated}</p>

      <slot />

      <section id="subscribe">
        <p class="subscribe-pitch">
          Want the week's local stories, news and events? Join The Tide.
        </p>
        <form id="subscribe-form" method="post" action="#" novalidate>
          <label class="visually-hidden" for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            spellcheck="false"
            placeholder="you@example.com"
            required
          />
          <button type="submit">Subscribe</button>
        </form>
        <p class="note" id="subscribe-note" role="status" aria-live="polite">
          Free forever. Unsubscribe any time.
        </p>
      </section>

      <p class="privacy-link"><a href="/privacy">How we handle your details</a></p>
    </main>

    <svg class="waves" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#a2c5d3"
        opacity="0.45"
        d="M0,96 C240,160 480,32 720,64 C960,96 1200,192 1440,128 L1440,220 L0,220 Z"
      ></path>
      <path
        fill="#a2c5d3"
        d="M0,160 C280,96 520,208 760,176 C1000,144 1240,96 1440,176 L1440,220 L0,220 Z"
      ></path>
    </svg>

    <script is:inline>
      // Same insert as the home page's form: the `subscribers` table, with the
      // publishable key. Row-level security only allows inserts.
      const SUPABASE_URL = 'https://jykpoupjvcmvoihujfkc.supabase.co';
      const SUPABASE_KEY = 'sb_publishable_aMYowr2D3KMWyiw7IpMeXw_GzXRrIxM';

      const subscribeForm = document.getElementById('subscribe-form');
      const subscribeEmail = subscribeForm.querySelector('#email');
      const subscribeNote = document.getElementById('subscribe-note');

      subscribeForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!subscribeEmail.checkValidity()) {
          subscribeNote.textContent = 'Please enter a valid email address.';
          subscribeNote.className = 'note error';
          subscribeEmail.focus();
          return;
        }

        const subscribeButton = subscribeForm.querySelector('button');
        subscribeButton.disabled = true;
        subscribeButton.textContent = 'Subscribing…';

        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/subscribers`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_KEY,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal',
            },
            body: JSON.stringify({ email: subscribeEmail.value.trim().toLowerCase() }),
          });

          // 409 = duplicate email: already subscribed, treat as success.
          if (response.ok || response.status === 409) {
            subscribeForm.hidden = true;
            subscribeNote.textContent =
              "You're in! Check your inbox for your welcome email, then keep an eye out for your weekly issue of The Tide.";
            subscribeNote.className = 'note success';
            return;
          }
          throw new Error(`Signup failed with status ${response.status}`);
        } catch {
          subscribeNote.textContent = 'Something went wrong — please try again in a moment.';
          subscribeNote.className = 'note error';
          subscribeButton.disabled = false;
          subscribeButton.textContent = 'Subscribe';
        }
      });

      subscribeEmail.addEventListener('input', () => {
        if (subscribeNote.classList.contains('error')) {
          subscribeNote.textContent = 'Free forever. Unsubscribe any time.';
          subscribeNote.className = 'note';
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  body {
    min-height: 100%;
    background:
      radial-gradient(120% 60% at 50% 0%, #faf5ea 0%, #f0e7d6 60%) no-repeat,
      #f0e7d6;
    color: #23313c;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  main {
    width: min(var(--main-width, 42rem), 100% - 2.5rem);
    margin-inline: auto;
    padding-block: 2.5rem 9rem;
    text-align: center;
  }

  .home img {
    width: min(7rem, 26vw);
    height: auto;
  }

  .breadcrumb {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: #8a8272;
  }

  .breadcrumb a {
    color: #8a8272;
    text-underline-offset: 0.15em;
  }

  .breadcrumb a:hover,
  .breadcrumb a:focus-visible {
    color: #45758c;
  }

  .breadcrumb span[aria-hidden] {
    margin: 0 0.35em;
  }

  .eyebrow {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #45758c;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(1.7rem, 1.5vw + 1.2rem, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .lede {
    margin: 1rem auto 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  .updated {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: #8a8272;
  }

  /* Shared by the hub's tiles and the category pages' listing cards — the same
     white-on-sand card the issues list and the coffee roundup use. */
  .card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem 1.35rem 1.5rem;
    text-align: left;
    background: #fffdf8;
    border: 1px solid rgba(35, 65, 90, 0.12);
    border-radius: 1rem;
    scroll-margin-top: 1.5rem;
  }

  .card:hover,
  .card:focus-within {
    border-color: rgba(69, 117, 140, 0.4);
  }

  .card-name {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .card-name a {
    color: #23313c;
    text-decoration-color: rgba(69, 117, 140, 0.45);
    text-underline-offset: 0.15em;
  }

  .card-name a:hover,
  .card-name a:focus-visible {
    color: #45758c;
  }

  .card-blurb {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  .footnote {
    margin: 1.5rem auto 0;
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  .footnote a {
    color: #35657d;
    text-underline-offset: 0.15em;
  }

  #subscribe {
    margin-top: 2.5rem;
  }

  .subscribe-pitch {
    margin-inline: auto;
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #5a6672;
    text-wrap: pretty;
  }

  form[hidden] {
    display: none;
  }

  form {
    display: flex;
    gap: 0.6rem;
    margin: 1.25rem auto 0;
    max-width: 28rem;
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 0.9rem 1.1rem;
    font: inherit;
    color: inherit;
    background: #fffdf8;
    border: 1px solid rgba(35, 65, 90, 0.25);
    border-radius: 0.65rem;
    transition: border-color 0.15s;
  }

  input::placeholder {
    color: #9aa4ac;
  }

  input:focus-visible {
    outline: none;
    border-color: #45758c;
    box-shadow: 0 0 0 3px rgba(162, 197, 211, 0.55);
  }

  button {
    padding: 0.9rem 1.6rem;
    font: inherit;
    font-weight: 700;
    color: #23313c;
    background: #a2c5d3;
    border: 0;
    border-radius: 0.65rem;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  button:hover,
  button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(69, 117, 140, 0.35);
  }

  button:active {
    transform: translateY(0);
  }

  button:disabled {
    cursor: default;
    transform: none;
    box-shadow: none;
    opacity: 0.7;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #8a8272;
  }

  .note.error {
    color: #b3372c;
  }

  .note.success {
    margin-inline: auto;
    max-width: 30rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: #1e7a4d;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .privacy-link {
    margin-top: 1.75rem;
    font-size: 0.8rem;
  }

  .privacy-link a {
    color: #8a8272;
    text-underline-offset: 0.15em;
  }

  .privacy-link a:hover,
  .privacy-link a:focus-visible {
    color: #45758c;
  }

  .waves {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    height: clamp(90px, 18vh, 220px);
    pointer-events: none;
  }

  @media (max-width: 30rem) {
    form {
      flex-direction: column;
    }

    button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
